<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <!-- Implicit usings and nullable refs are not supported on net472 -->
    <LangVersion>7.3</LangVersion>
    <AssemblyName>WondePoC</AssemblyName>
    <RootNamespace>WondePoC</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="secrets.config" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="secrets.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- net472 SDK-style projects don't auto-reference all framework assemblies -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net" />
  </ItemGroup>

</Project>
