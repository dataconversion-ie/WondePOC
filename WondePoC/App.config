<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings file="secrets.config">
    <!-- Wonde API base URL - change per region (UK/IE: api.wonde.com) -->
    <add key="WondeBaseUrl"  value="https://api.wonde.com/v1.0/" />
    <add key="WondeApiToken" value="" />
    <!-- URN 10003 maps to Wonde encoded ID A1930499544 (discovered via GET /schools) -->
    <add key="WondeSchoolId" value="A1930499544" />
  </appSettings>
</configuration>
